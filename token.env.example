# Copy this file to token.env and fill the values locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for AI editing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional selectable LLM gateway engine for AI editing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional YouTube download workarounds for HTTP 403.
# Example: chrome, edge, firefox
YTDLP_COOKIES_FROM_BROWSER=
# Or use an exported Netscape-format cookies.txt file.
YTDLP_COOKIEFILE=
YTDLP_PLAYER_CLIENT=web_embedded
# Progressive MP4 is more reliable than separate DASH streams for YouTube.
YTDLP_FORMAT=best[ext=mp4]/best
