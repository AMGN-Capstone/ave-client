# Copy this file to token.env and fill the values locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional hosted STT fallback. The default provider is local faster-whisper.
# TRANSCRIPTION_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Required for AI editing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional YouTube download workarounds for HTTP 403.
# Example: chrome, edge, firefox
YTDLP_COOKIES_FROM_BROWSER=
# Or use an exported Netscape-format cookies.txt file.
YTDLP_COOKIEFILE=
YTDLP_PLAYER_CLIENT=android_vr
# Progressive MP4 is more reliable than separate DASH streams for YouTube.
YTDLP_FORMAT=best[ext=mp4]/best
